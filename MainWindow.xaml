<Window x:Class="PhotoBooth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Photo Booth" Icon="app.ico"
        WindowStyle="None" ResizeMode="CanResize" WindowState="Maximized"
        Width="1280" Height="800" MinWidth="880" MinHeight="620"
        Background="#0A0A0D" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown"
        Activated="Window_Activated" Deactivated="Window_Deactivated">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- ================= Bahan "kaca" ================= -->
        <DropShadowEffect x:Key="GlassShadow" BlurRadius="40" ShadowDepth="10" Direction="270"
                          Opacity="0.35" Color="Black"/>

        <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#0FFFFFFF" Offset="0.45"/>
            <GradientStop Color="#1CFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B8FFFFFF" Offset="0"/>
            <GradientStop Color="#26FFFFFF" Offset="0.35"/>
            <GradientStop Color="#1AFFFFFF" Offset="0.65"/>
            <GradientStop Color="#80FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Glass" TargetType="ContentControl">
            <Setter Property="Tag">
                <Setter.Value>
                    <CornerRadius>28</CornerRadius>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border CornerRadius="{TemplateBinding Tag}" Background="#70101016"
                                    Effect="{StaticResource GlassShadow}"/>
                            <Border CornerRadius="{TemplateBinding Tag}" Background="{StaticResource GlassSheen}"/>
                            <Border CornerRadius="{TemplateBinding Tag}" BorderThickness="1.2"
                                    BorderBrush="{StaticResource GlassRim}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPill" TargetType="ContentControl" BasedOn="{StaticResource Glass}">
            <Setter Property="Tag">
                <Setter.Value>
                    <CornerRadius>60</CornerRadius>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="ContentControl" BasedOn="{StaticResource Glass}">
            <Setter Property="Tag">
                <Setter.Value>
                    <CornerRadius>24</CornerRadius>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Tombol lampu lalu lintas ala Mac ================= -->
        <Style x:Key="Light" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Tag" Value="off"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#40000000" StrokeThickness="0.8"/>
                            <ContentPresenter x:Name="glyph" Opacity="0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="glyph" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Tombol ikon bulat (kaca) ================= -->
        <Style x:Key="GlassIcon" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="sc"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="bg" Fill="#22FFFFFF" Stroke="{StaticResource GlassRim}" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#3EFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1.1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1.1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Tombol shutter ================= -->
        <Style x:Key="ShutterButton" TargetType="Button">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="sc"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="#22FFFFFF" Stroke="#F2FFFFFF" StrokeThickness="4"/>
                            <Rectangle x:Name="inner" Width="62" Height="62" RadiusX="31" RadiusY="31" Fill="#EE3B34"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="inner" Property="Fill" Value="#FF5249"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="inner" Property="Fill" Value="#B72A24"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX"
                                                             To="0.92" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY"
                                                             To="0.92" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Saat merekam: lingkaran berubah jadi kotak "stop" -->
                            <Trigger Property="Tag" Value="rec">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="Width" To="32" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="Height" To="32" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="RadiusX" To="9" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="RadiusY" To="9" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="Width" To="62" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="Height" To="62" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="RadiusX" To="31" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="inner" Storyboard.TargetProperty="RadiusY" To="31" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Item thumbnail ================= -->
        <Style x:Key="ThumbItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Thumb_RightClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent"
                                Padding="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Slider kaca ================= -->
        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderFillButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#D9FFFFFF" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="#40000000" StrokeThickness="1">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="#44FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol teks kecil bergaya kaca -->
        <Style x:Key="GlassTextButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="#26FFFFFF" Padding="14,5"
                                BorderThickness="1" BorderBrush="#33FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch bergaya iOS -->
        <Style x:Key="GlassSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="track" CornerRadius="13" Background="#55FFFFFF" BorderThickness="1" BorderBrush="#33FFFFFF"/>
                            <Ellipse x:Name="knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#FF34C759"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="Margin"
                                                                To="21,0,0,0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="Margin"
                                                                To="3,0,0,0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#33000000" CornerRadius="10" BorderThickness="1" BorderBrush="#40FFFFFF" Padding="10,6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ================= Pratinjau kamera memenuhi seluruh jendela ================= -->
        <Image x:Name="Preview" Stretch="Uniform"/>
        <Canvas x:Name="GridCanvas" IsHitTestVisible="False" SizeChanged="GridCanvas_SizeChanged"/>

        <TextBlock x:Name="NoCamera" Visibility="Collapsed" Foreground="#B3FFFFFF" FontSize="20"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Text="Kamera tidak ditemukan.&#x0A;Pastikan webcam terpasang dan tidak dipakai aplikasi lain,&#x0A;lalu cek Settings › Privacy › Camera."/>

        <Image x:Name="Viewer" Stretch="Uniform" Visibility="Collapsed"/>
        <Button x:Name="ViewerClose" Style="{StaticResource GlassIcon}" Content="&#xE711;" Width="40" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,24,0" Visibility="Collapsed"
                Click="ViewerClose_Click" ToolTip="Tutup pratinjau (Esc)"/>

        <!-- Bayangan lembut di atas supaya tombol jendela tetap terbaca -->
        <Border Height="110" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ================= Panel efek 3x3 ================= -->
        <Border x:Name="TilesHost" Visibility="Collapsed" Margin="56,64,56,250" CornerRadius="30"
                Background="#E60C0C10" BorderThickness="1.2" BorderBrush="{StaticResource GlassRim}"
                Padding="14,10" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="TilesScale"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="PageTitle" Grid.Row="0" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,2,0,6"/>

                <UniformGrid x:Name="TilesGrid" Grid.Row="1" Rows="3" Columns="3"/>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource GlassIcon}" Content="&#xE76B;" Tag="-1"
                            Width="40" Height="40" Click="PageNav_Click" ToolTip="Halaman sebelumnya (←)"/>
                    <StackPanel x:Name="PageDots" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource GlassIcon}" Content="&#xE76C;" Tag="1"
                            Width="40" Height="40" Click="PageNav_Click" ToolTip="Halaman berikutnya (→)"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= Hitung mundur ================= -->
        <TextBlock x:Name="Countdown" Visibility="Collapsed" Foreground="White" FontSize="220"
                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <ScaleTransform x:Name="CdScale"/>
            </TextBlock.RenderTransform>
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Indikator atas -->
        <TextBlock x:Name="ShotLabel" Visibility="Collapsed" Foreground="White" FontSize="20"
                   FontWeight="SemiBold" Margin="24,62" IsHitTestVisible="False"
                   HorizontalAlignment="Right" VerticalAlignment="Top">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock x:Name="RecText" Visibility="Collapsed" Text="● 00:00" Foreground="#FF5249"
                   FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Chip status AI (klik untuk memilih NPU / GPU / CPU) -->
        <Border x:Name="AiChip" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,24,0"
                CornerRadius="16" Padding="14,6" Background="#80101016" BorderThickness="1"
                BorderBrush="{StaticResource GlassRim}" Cursor="Hand"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="AiChip_Click"
                ToolTip="Prosesor AI untuk efek AR">
            <TextBlock x:Name="AiChipText" Text="AI · belum aktif" Foreground="White" FontSize="13"
                       FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="SceneChip" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="116,12,0,0" CornerRadius="16" Padding="14,6"
                Background="#80101016" BorderThickness="1" BorderBrush="{StaticResource GlassRim}">
            <TextBlock x:Name="SceneChipText" Foreground="#FFFFD60A" FontSize="13" FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="FaceHint" Visibility="Collapsed" IsHitTestVisible="False" Margin="0,116,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="20" Padding="18,8"
                Background="#99101016" BorderThickness="1" BorderBrush="{StaticResource GlassRim}">
            <TextBlock x:Name="FaceHintText" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
        </Border>

        <!-- Notifikasi kecil (nama efek / kamera) -->
        <Border x:Name="Toast" Opacity="0" IsHitTestVisible="False" Margin="0,66,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="20"
                Padding="18,8" Background="#99101016" BorderThickness="1" BorderBrush="{StaticResource GlassRim}">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
        </Border>

        <!-- ================= Dock kaca di bawah ================= -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28">

            <!-- Pulau galeri (gaya Dynamic Island): muncul saat tombol Galeri di-hover, klik untuk menyematkan -->
            <ContentControl x:Name="ThumbsCard" Style="{StaticResource GlassCard}" Padding="12,10"
                            Margin="0,0,0,14" MinWidth="300" MaxWidth="760" Visibility="Collapsed" Opacity="0"
                            RenderTransformOrigin="0.5,1"
                            MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                            MouseLeftButtonUp="Island_Click">
                <ContentControl.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="IslandScale"/>
                        <TranslateTransform x:Name="IslandShift"/>
                    </TransformGroup>
                </ContentControl.RenderTransform>
                <StackPanel>
                    <Grid Margin="4,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IslandPin" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="White" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IslandTitle" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GlassIcon}" Content="&#xE838;" Width="30" Height="30" FontSize="12"
                                    Click="Folder_Click" ToolTip="Buka folder hasil"/>
                            <Button x:Name="IslandClose" Style="{StaticResource GlassIcon}" Content="&#xE711;" Width="30"
                                    Height="30" FontSize="11" Visibility="Collapsed" Click="IslandClose_Click"
                                    ToolTip="Sembunyikan galeri (Esc)"/>
                        </StackPanel>
                    </Grid>
                <ListBox x:Name="Thumbs" Height="70" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource ThumbItem}"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         PreviewMouseWheel="Thumbs_Wheel"
                         SelectionChanged="Thumbs_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="96" Height="54">
                                <Rectangle RadiusX="10" RadiusY="10">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#80000000"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsVideo, Converter={StaticResource B2V}}">
                                    <TextBlock Text="▶" Foreground="White" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Salin" Click="Copy_Click"/>
                            <MenuItem Header="Tampilkan di folder" Click="ShowInFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="Hapus" Click="Delete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                </StackPanel>
            </ContentControl>

            <!-- Penyesuaian cahaya -->
            <ContentControl x:Name="AdjustCard" Style="{StaticResource GlassCard}" Padding="18,12"
                            Margin="0,0,0,14" Width="380" Visibility="Collapsed" Opacity="0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Penyesuaian cahaya" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GlassTextButton}" Content="Setel ulang" HorizontalAlignment="Right"
                                Click="AdjReset_Click"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kecerahan" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="AdjBright" Grid.Column="1" Style="{StaticResource GlassSlider}"
                                Minimum="-80" Maximum="80" Value="0" SmallChange="1" LargeChange="10"
                                ValueChanged="Adj_Changed"/>
                        <TextBlock x:Name="AdjBrightVal" Grid.Column="2" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kontras" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="AdjContrast" Grid.Column="1" Style="{StaticResource GlassSlider}"
                                Minimum="0.6" Maximum="1.6" Value="1" SmallChange="0.01" LargeChange="0.1"
                                ValueChanged="Adj_Changed"/>
                        <TextBlock x:Name="AdjContrastVal" Grid.Column="2" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Eksposur" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="AdjExposure" Grid.Column="1" Style="{StaticResource GlassSlider}"
                                Minimum="-1" Maximum="1" Value="0" SmallChange="0.05" LargeChange="0.25"
                                ValueChanged="Adj_Changed"/>
                        <TextBlock x:Name="AdjExposureVal" Grid.Column="2" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="AutoLevelBtn" Style="{StaticResource GlassTextButton}" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Click="AutoLevel_Click"
                            ToolTip="Meredam gambar yang terlalu terang secara otomatis"/>
                </StackPanel>
            </ContentControl>

            <!-- Pengaturan -->
            <ContentControl x:Name="SettingsCard" Style="{StaticResource GlassCard}" Padding="18,12"
                            Margin="0,0,0,14" Width="430" Visibility="Collapsed" Opacity="0">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Pengaturan" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GlassIcon}" Content="&#xE711;" Width="28" Height="28" FontSize="11"
                                HorizontalAlignment="Right" Click="SettingsClose_Click" ToolTip="Tutup (Esc)"/>
                    </Grid>
                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="FOTO" Foreground="#FFFFD60A" FontSize="11" FontWeight="Bold" Margin="0,12,0,2"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Watermark &quot;Shot on&quot;" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Teks di pojok kiri bawah foto" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="SwWatermark" Grid.Column="1" Style="{StaticResource GlassSwitch}" Tag="watermark"
                                      Click="Setting_Toggled"/>
                    </Grid>
                    <TextBox x:Name="WatermarkBox" Style="{StaticResource GlassTextBox}" MaxLength="60"
                             TextChanged="WatermarkBox_TextChanged" Margin="0,0,0,4"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Cap waktu (timestamp)" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Tepat di atas watermark &quot;Shot on&quot;" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="SwTimestamp" Grid.Column="1" Style="{StaticResource GlassSwitch}" Tag="timestamp"
                                      Click="Setting_Toggled"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Garis bantu (grid)" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Hanya di layar, tidak masuk ke foto" Foreground="#99FFFFFF" FontSize="11"/>
                        </StackPanel>
                        <Button x:Name="GridBtn" Grid.Column="1" Style="{StaticResource GlassTextButton}" Click="Grid_Click"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Suara jepretan" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Bunyi rana saat foto diambil" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="SwShutter" Grid.Column="1" Style="{StaticResource GlassSwitch}" Tag="shutter"
                                      Click="Setting_Toggled"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Suara timer" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Bip tiap detik saat hitung mundur" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="SwTimerSound" Grid.Column="1" Style="{StaticResource GlassSwitch}" Tag="timersound"
                                      Click="Setting_Toggled"/>
                    </Grid>
                    <TextBlock Text="AI &amp; SENSOR" Foreground="#FFFFD60A" FontSize="11" FontWeight="Bold" Margin="0,12,0,2"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Auto filter AI (scene)" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Mendeteksi makanan, pemandangan, langit, malam, potret, hewan" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="SwScene" Grid.Column="1" Style="{StaticResource GlassSwitch}" Tag="scene"
                                      Click="Setting_Toggled"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Palm shoot" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Telapak terbuka menghadap kamera ±1 detik = foto (eksperimental)" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="SwPalm" Grid.Column="1" Style="{StaticResource GlassSwitch}" Tag="palm"
                                      Click="Setting_Toggled"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Cheese shoot" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Ucapkan &quot;cheese&quot; untuk memotret" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="SwCheese" Grid.Column="1" Style="{StaticResource GlassSwitch}" Tag="cheese"
                                      Click="Setting_Toggled"/>
                    </Grid>
                    <TextBlock Text="VIDEO" Foreground="#FFFFD60A" FontSize="11" FontWeight="Bold" Margin="0,12,0,2"/>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Rekam suara" Foreground="White" FontSize="13"/>
                            <TextBlock Text="Memakai mikrofon saat merekam video" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="SwAudio" Grid.Column="1" Style="{StaticResource GlassSwitch}" Tag="audio"
                                      Click="Setting_Toggled"/>
                    </Grid>
                    <TextBlock Text="PENYIMPANAN" Foreground="#FFFFD60A" FontSize="11" FontWeight="Bold" Margin="0,12,0,2"/>
                    <TextBlock x:Name="FolderText" Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Style="{StaticResource GlassTextButton}" Content="Pilih folder…" Click="PickFolder_Click"/>
                        <Button Style="{StaticResource GlassTextButton}" Content="Bawaan" Margin="8,0,0,0" Click="ResetFolder_Click"/>
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </ContentControl>

            <Button x:Name="PauseBtn" Style="{StaticResource GlassIcon}" Content="&#xE769;" Width="56" Height="56"
                    FontSize="22" Margin="0,0,0,12" Visibility="Collapsed" Click="Pause_Click" ToolTip="Jeda rekaman"/>

            <!-- Dock kontrol -->
            <ContentControl Style="{StaticResource GlassPill}" Padding="22,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GlassIcon}" Content="&#xE790;" ToolTip="Efek"
                                Click="Effects_Click"/>
                        <Button Style="{StaticResource GlassIcon}" Content="&#xE722;" ToolTip="Pilih / ganti kamera"
                                Click="Camera_Click"/>

                        <!-- Timer (hanya berlaku di mode Foto) -->
                        <Button x:Name="TimerBtn" Style="{StaticResource GlassIcon}" Click="Timer_Click">
                            <Grid Width="40" Height="40">
                                <TextBlock Text="&#xE916;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TimerBadge" Text="3s" FontFamily="Segoe UI" FontSize="10"
                                           FontWeight="Bold" Foreground="#FFFFD60A" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" Margin="0,0,-3,-1"/>
                            </Grid>
                        </Button>

                        <!-- Galeri: hover = pulau muncul, klik = disematkan -->
                        <Button x:Name="GalleryBtn" Style="{StaticResource GlassIcon}" Click="Gallery_Click"
                                MouseEnter="Gallery_MouseEnter" MouseLeave="Gallery_MouseLeave"
                                ToolTip="Galeri: arahkan kursor untuk melihat, klik untuk menyematkan">
                            <Grid Width="40" Height="40">
                                <Ellipse x:Name="GalleryThumb" Width="38" Height="38" Visibility="Collapsed"/>
                                <TextBlock x:Name="GalleryGlyph" Text="&#xE8B9;" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button x:Name="AdjustBtn" Style="{StaticResource GlassIcon}" Content="&#xE706;"
                                Click="Adjust_Click" ToolTip="Penyesuaian cahaya (kecerahan, kontras, eksposur)"/>
                        <Button x:Name="SettingsBtn" Style="{StaticResource GlassIcon}" Content="&#xE713;"
                                Click="Settings_Click" ToolTip="Pengaturan"/>
                    </StackPanel>

                    <Button x:Name="Shutter" Style="{StaticResource ShutterButton}" Margin="20,0"
                            VerticalAlignment="Center" ToolTip="Ambil foto / rekam (Spasi)"
                            Click="Shutter_Click"/>

                    <!-- Slider mode: 4 Foto / Foto / Video -->
                    <Grid x:Name="ModeSlider" Width="288" Height="46" VerticalAlignment="Center"
                          Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="Mode_Down" MouseMove="Mode_Move" MouseLeftButtonUp="Mode_Up">
                        <Border CornerRadius="23" Background="#33000000" BorderThickness="1" BorderBrush="#22FFFFFF"/>

                        <Border x:Name="ModeThumb" Width="90" Margin="3" HorizontalAlignment="Left"
                                CornerRadius="20" Background="#55FFFFFF" BorderThickness="1"
                                BorderBrush="{StaticResource GlassRim}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbShift"/>
                            </Border.RenderTransform>
                            <Border CornerRadius="20" Background="{StaticResource GlassSheen}"/>
                        </Border>

                        <UniformGrid Columns="3" IsHitTestVisible="False">
                            <TextBlock x:Name="ModeLbl0" Text="4 Foto" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModeLbl1" Text="Foto" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModeLbl2" Text="Video" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </UniformGrid>
                    </Grid>
                </StackPanel>
            </ContentControl>
        </StackPanel>

        <!-- Kilatan layar -->
        <Border x:Name="Flash" Background="White" Opacity="0" IsHitTestVisible="False"/>

        <!-- ================= Tombol jendela ala macOS (kiri atas) ================= -->
        <StackPanel x:Name="Lights" Orientation="Horizontal" Margin="20,17,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    MouseEnter="Lights_MouseEnter" MouseLeave="Lights_MouseLeave">
            <Button x:Name="BtnClose" Style="{StaticResource Light}" Background="#FF5F57"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Tutup">
                <Path Data="M0,0 L6,6 M6,0 L0,6" Stroke="#B0000000" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
            <Button x:Name="BtnMin" Style="{StaticResource Light}" Background="#FEBC2E"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimize">
                <Path Data="M0,0 L7,0" Stroke="#B0000000" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
            <Button x:Name="BtnMax" Style="{StaticResource Light}" Background="#28C840"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maximize / Restore">
                <Path Data="M0,6 L0,1 L5,6 Z M6,0 L6,5 L1,0 Z" Fill="#B0000000"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
