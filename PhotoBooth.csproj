<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows ML membutuhkan TFM Windows 10 (17763 atau lebih baru) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <AssemblyName>PhotoBooth</AssemblyName>
    <RootNamespace>PhotoBooth</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- Stiker AR dan (opsional) model AI untuk distribusi offline ikut disalin ke folder output -->
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.9.0.20240103" />

    <!-- Windows ML: ONNX Runtime bersama + unduhan akselerator NPU/GPU (self-contained, tanpa paket WindowsAppSDK utama).
         Jika restore gagal pada versi ini, jalankan: dotnet add package Microsoft.WindowsAppSDK.ML -->
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.*" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" />
    <!-- Perekaman suara dari mikrofon untuk video -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
